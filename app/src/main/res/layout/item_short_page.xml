<?xml version="1.0" encoding="utf-8"?>
<!-- Stream: one full-screen page of the vertical Shorts player -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/short_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.google.android.exoplayer2.ui.StyledPlayerView
        android:id="@+id/short_player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:shutter_background_color="@android:color/black"
        app:surface_type="texture_view"
        app:use_controller="false" />

    <ImageView
        android:id="@+id/short_thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        tools:ignore="ContentDescription" />

    <View
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_gravity="bottom"
        android:background="@drawable/shorts_card_scrim" />

    <ProgressBar
        android:id="@+id/short_loading"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="@android:color/white" />

    <ImageView
        android:id="@+id/short_pause_icon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:alpha="0.85"
        android:src="@drawable/ic_play_arrow"
        android:visibility="gone"
        app:tint="@android:color/white"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/short_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="32dp"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Right rail -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="12dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/short_action_like"
            style="@style/StreamShortAction"
            android:text="@string/short_action_like"
            app:drawableTopCompat="@drawable/ic_thumb_up" />

        <TextView
            android:id="@+id/short_action_comments"
            style="@style/StreamShortAction"
            android:text="@string/short_action_comments"
            app:drawableTopCompat="@drawable/ic_comment" />

        <TextView
            android:id="@+id/short_action_share"
            style="@style/StreamShortAction"
            android:text="@string/short_action_share"
            app:drawableTopCompat="@drawable/ic_share" />

        <TextView
            android:id="@+id/short_action_save"
            style="@style/StreamShortAction"
            android:text="@string/short_action_save"
            app:drawableTopCompat="@drawable/ic_playlist_add" />

        <TextView
            android:id="@+id/short_action_more"
            style="@style/StreamShortAction"
            android:text="@string/short_action_more"
            app:drawableTopCompat="@drawable/ic_more_vert" />
    </LinearLayout>

    <!-- Channel + title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginEnd="60dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:id="@+id/short_channel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/short_avatar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_person"
                app:shapeAppearanceOverlay="@style/StreamCircleShape"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/short_channel_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:shadowColor="#99000000"
                android:shadowRadius="4"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                tools:text="\@channel" />
        </LinearLayout>

        <TextView
            android:id="@+id/short_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowRadius="4"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            tools:text="Title of the short" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/short_progress"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="bottom"
        android:max="1000"
        android:progressBackgroundTint="#55FFFFFF"
        android:progressTint="@color/stream_rose" />

</FrameLayout>
