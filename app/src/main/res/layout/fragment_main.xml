<?xml version="1.0" encoding="utf-8"?>
<!-- Stream: main screen = pages + YouTube-style bottom navigation -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.schabi.newpipe.views.ScrollableTabLayout
        android:id="@+id/main_tab_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_alignParentBottom="true"
        android:background="?android:attr/windowBackground"
        app:tabGravity="fill"
        app:tabIndicatorHeight="0dp"
        app:tabMinWidth="60dp"
        app:tabMode="fixed"
        app:tabPaddingBottom="0dp"
        app:tabPaddingTop="0dp"
        app:tabRippleColor="@android:color/transparent" />

    <View
        android:id="@+id/main_tab_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@id/main_tab_layout"
        android:background="?attr/separator_color" />

    <org.schabi.newpipe.views.StreamTabPager
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/main_tab_divider" />

</RelativeLayout>
