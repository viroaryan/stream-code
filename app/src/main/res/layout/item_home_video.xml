<?xml version="1.0" encoding="utf-8"?>
<!-- Stream: big edge-to-edge video card of the Home feed (YouTube-style) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_video_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingBottom="20dp">

    <ImageView
        android:id="@+id/home_video_thumb"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/black_card_item_background_color"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="H,16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/home_video_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:background="@drawable/bg_duration_badge"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="5dp"
        android:paddingTop="1dp"
        android:paddingEnd="5dp"
        android:paddingBottom="1dp"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/home_video_thumb"
        app:layout_constraintEnd_toEndOf="@id/home_video_thumb"
        tools:text="10:24" />

    <ProgressBar
        android:id="@+id/home_video_progress"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:progressDrawable="?progress_horizontal_drawable"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/home_video_thumb"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/home_video_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="centerCrop"
        android:src="@drawable/placeholder_person"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/home_video_thumb"
        app:shapeAppearanceOverlay="@style/StreamCircleShape"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/home_video_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:lineSpacingExtra="1dp"
        android:maxLines="2"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="15sp"
        app:layout_constraintEnd_toStartOf="@id/home_video_more"
        app:layout_constraintStart_toEndOf="@id/home_video_avatar"
        app:layout_constraintTop_toBottomOf="@id/home_video_thumb"
        tools:text="Rebuilding Discord in Rust | Project Phoenix" />

    <TextView
        android:id="@+id/home_video_meta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12.5sp"
        app:layout_constraintEnd_toEndOf="@id/home_video_title"
        app:layout_constraintStart_toStartOf="@id/home_video_title"
        app:layout_constraintTop_toBottomOf="@id/home_video_title"
        tools:text="Discord · 950K views · 3 days ago" />

    <ImageView
        android:id="@+id/home_video_more"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/more_options"
        android:padding="10dp"
        android:src="@drawable/ic_more_vert"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/home_video_thumb"
        app:tint="?android:attr/textColorPrimary" />

</androidx.constraintlayout.widget.ConstraintLayout>
