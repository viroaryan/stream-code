<?xml version="1.0" encoding="utf-8"?>
<!-- Stream: one recently watched video in the You tab's History row -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="164dp"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="4dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/you_history_thumb"
        android:layout_width="156dp"
        android:layout_height="88dp"
        android:background="@color/black_card_item_background_color"
        android:scaleType="centerCrop"
        android:src="@drawable/placeholder_thumbnail_video"
        app:shapeAppearanceOverlay="@style/StreamThumbShape"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/you_history_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="13sp"
        tools:text="Video title that can be quite long" />

    <TextView
        android:id="@+id/you_history_channel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp"
        tools:text="Channel name" />

</LinearLayout>
