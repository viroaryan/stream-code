<?xml version="1.0" encoding="utf-8"?>
<!-- Stream: big portrait Shorts card used in the Home Shorts grid and the Shorts tab -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_short_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/home_short_thumb"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/black_card_item_background_color"
        android:foreground="?attr/selectableItemBackground"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="H,9:13.5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/StreamShortsCardShape"
        tools:ignore="ContentDescription" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/shorts_card_scrim"
        app:layout_constraintBottom_toBottomOf="@id/home_short_thumb"
        app:layout_constraintEnd_toEndOf="@id/home_short_thumb"
        app:layout_constraintHeight_percent="0.45"
        app:layout_constraintStart_toStartOf="@id/home_short_thumb" />

    <ImageView
        android:id="@+id/home_short_more"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_margin="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/more_options"
        android:padding="8dp"
        android:src="@drawable/ic_more_vert"
        app:layout_constraintEnd_toEndOf="@id/home_short_thumb"
        app:layout_constraintTop_toTopOf="@id/home_short_thumb"
        app:tint="@android:color/white" />

    <TextView
        android:id="@+id/home_short_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:shadowColor="#99000000"
        android:shadowRadius="4"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        app:layout_constraintBottom_toTopOf="@id/home_short_views"
        app:layout_constraintEnd_toEndOf="@id/home_short_thumb"
        app:layout_constraintStart_toStartOf="@id/home_short_thumb"
        tools:text="Forging Cable into an axe." />

    <TextView
        android:id="@+id/home_short_views"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#D9FFFFFF"
        android:textSize="12.5sp"
        app:layout_constraintBottom_toBottomOf="@id/home_short_thumb"
        app:layout_constraintEnd_toEndOf="@id/home_short_thumb"
        app:layout_constraintStart_toStartOf="@id/home_short_thumb"
        tools:text="1.2M views" />

</androidx.constraintlayout.widget.ConstraintLayout>
